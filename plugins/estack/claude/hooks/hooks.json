{
  "description": "Provide Claude-specific workflow guidance.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/claude/scripts/inject-fable-orchestration.py"
            ]
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/claude/scripts/inject-home-instructions.py"
            ]
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/claude/scripts/inject-repo-skills.py"
            ]
          }
        ]
      },
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/claude/scripts/report-sync-state.py"
            ]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(?!(Explore|Plan)$)",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/claude/scripts/inject-home-instructions.py"
            ]
          },
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/claude/scripts/inject-repo-skills.py"
            ]
          }
        ]
      }
    ]
  }
}
