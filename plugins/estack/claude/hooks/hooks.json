{
  "description": "Provide Claude-specific workflow guidance.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/claude/scripts/inject-fable-orchestration.py"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf",
            "args": [
              "%s\\n",
              "Use plain, direct language. Represent the subject's inherent complexity faithfully, but do not add complexity through jargon, structure, or wording. Preserve important details, evidence, and caveats."
            ]
          }
        ]
      }
    ]
  }
}
